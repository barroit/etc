M106 P1 S255
M109 S140
M106 P1 S0

G92 E0
G1 E-0.8 F300

G1 X128 F30000

G92 E0
G1 E-0.2 F300

M400

M190 S[bed_temperature_initial_layer_single]
				; wait for bed temperature

M1002 judge_flag g29_before_print_flag
M622 J1				; if g29_before_print_flag
  M1002 gcode_claim_action:1

  G29 A X{
	  first_layer_print_min[0]
  } Y{
	  first_layer_print_min[1]
  } I{
	  first_layer_print_size[0]
  } J{
	  first_layer_print_size[1]
  }			; probe the first layer print area
  M400

;====== machine: P1S
;====== nozzle: 0.4
;====== birth: 20251031
;====== modify: 20260820

;====== set fan speed

M106 P1 S0			; set part cooling fan to 0%
M106 P2 S0			; set AUX fan to 0%
M106 P3 S77			; set chamber fan to 30%
M710 A1 S255			; set motherboard fan to 100%

;====== init machine status
M290 X40 Y40 Z2.6666666		; ?

M975 S1				; enable vibration suppression

M221 X0 Y0 Z0			; disable XYZ soft endstops

G29.1 Z{+0.0}			; set Z trim

M17 X1.2 Y1.2 Z0.75		; set motor current

M204 S10000			; set acceleration limit to 10000 mm/s²

M220 S100			; set feedrate
M221 S100			; set flowrate

M960 S5 P1			; turn on logo light
M73.2 R1.0			; set remaining time multiplier
M1002 set_gcode_claim_speed_level:5
				; set displayed speed profile state

;====== set bed and hotend temperature
M104 S{nozzle_temperature_initial_layer[initial_extruder] - 20}
				; set nozzle temperature
M140 S{bed_temperature_initial_layer[initial_extruder]}
				; set bed temperature

;====== PLA: cool chamber to prevent heat creep
{ if filament_type[initial_extruder] == "PLA" }
  M106 P3 S180
  M106 P2 S100
{ endif }

;====== lower bed for nozzle clearance
G91				; set relative position mode
  M17 S				; save current state
  M17 Z0.4			; lower Z motor current
    G380 S2 Z20 F300		; lower bed, with collision detection
  M17 R
G90				; set absolute position mode

;====== move toolhead to center
G1 X128 F30000
G1 Y128

M400				; wait for all queued moves to finish

;====== AMS: load initial filament
M620 M				; enable AMS filament remapping
M620 S{initial_extruder}A	; execute following only if AMS is being used
  M620.1 E F{
	  flush_volumetric_speeds[initial_extruder] / 2.4053 * 60
  } T{
	  flush_temperatures[initial_extruder]
  }				; set AMS flush feedrate and temperature

  T{initial_extruder}		; start loading
  M400
M621 S{initial_extruder}

M412 S1				; enable filament runout detection
M109 S{flush_temperatures[initial_extruder]}

M83				; set relative extrusion mode
  G1 E50 F200			; extrude 50 mm of filament at 200 mm/min
  M400

  M104 S{nozzle_temperature_initial_layer[initial_extruder] - 39}
  M106 P1 S77

  G1 E50 F200
M82

